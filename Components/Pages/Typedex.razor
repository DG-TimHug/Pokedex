@page "/typedex"
<h3>TypeDex</h3>

@using System.Data;
@using PokeDex.DataAccessLibrary

@inject TypedexData Db
@inject ILogger<Typedex> Logger

<div class="container-fluid">
    <div class="d-flex flex-row">
        <table class="table table-striped table-light">
            <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Abbreviation</th>
            </tr>
            </thead>
            <tbody>
            @foreach (DataRow row in typedex.Rows)
            {
                string? name = row["Name"].ToString();
                string? abbreviation = row["Abbreviation"].ToString();
                string? slug = row["Slug"].ToString();

                <tr>
                    <td><a href="/typedex/@slug/">@name</a></td>
                    <td><span class="type-label type-@slug">@abbreviation</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>


@code {
    DataTable typedex = new DataTable();
    protected override async Task OnInitializedAsync()
    {
        typedex = Db.GetAllTypes();
    }
}